# 复制为 .env 并填写；也可用系统环境变量设置。仓库内不保存任何真实凭据。

# ---- Neo4j（必填密码）----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DB=neo4j

# ---- 原始数据目录（分城市景点 CSV）----
CITYDATA_DIR=./data/raw

# ---- 可选：问答模块大模型（OpenAI 兼容接口），留空则自动使用规则解析 ----
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.5-flash
AGNES_TIMEOUT=20
AGNES_MAX_TOKENS=900
